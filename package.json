{
  "name": "mermaid4pptx",
  "version": "1.0.3",
  "private": true,
  "description": "PowerPoint add-in that renders Mermaid diagrams written in slide notes",
  "license": "MIT",
  "scripts": {
    "build": "webpack --mode production",
    "build:release": "npm run build && node scripts/build-manifest.js",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:release": "office-addin-manifest validate dist/manifest.xml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "node scripts/render-check.js",
    "check:tools": "node -e \"require('office-addin-debugging/lib/commands.js'); require('office-addin-dev-settings'); require('office-addin-dev-certs')\""
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "jszip": "3.10.2",
    "mermaid": "11.12.0"
  },
  "devDependencies": {
    "@types/office-js": "1.0.614",
    "copy-webpack-plugin": "14.0.0",
    "html-webpack-plugin": "5.6.8",
    "license-webpack-plugin": "4.0.2",
    "office-addin-debugging": "7.0.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1",
    "playwright": "1.63.0",
    "semver": "7.8.5",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7"
  },
  "config": {
    "app_to_debug": "powerpoint",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  }
}
